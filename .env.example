# Database (docker-compose.yml or a native install)
DATABASE_URL=postgres://viewings:viewings@localhost:5432/viewings

# App
APP_ENV=development
APP_TIMEZONE=America/New_York
# Accept the x-test-now header. Never set in production.
ALLOW_TEST_CLOCK=true
# Optional: comma-separated hosts (IP addresses or hostnames, without scheme or port) from which
# another machine on the local network may open the dev server. See README section 5.
# DEV_ALLOWED_ORIGINS=192.168.1.20,devbox.local

# Clerk (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
E2E_CLERK_USER_EMAIL=staff+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=replace_me

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Viewings <no-reply@viewings.example>"
MAILPIT_URL=http://localhost:8025

# SMS: recording (default) or twilio
SMS_PROVIDER=recording
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# Twilio test credentials for the contract tests (the sms-contract project).
# Without them the contract tests are skipped. Running sms-contract also needs the Clerk keys
# and the Clerk test user above, because global setup creates a Clerk session for every run.
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=

# Optional: test a running environment instead of starting the app
# BASE_URL=https://staging.example.com
